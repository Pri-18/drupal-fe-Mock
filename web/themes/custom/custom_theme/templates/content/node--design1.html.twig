<div class="design1">
	<div class="design1__wrapper">

		<div class="design1__image__content">
			{% if content.field_blog_image %}
				<div class="design1__image">
					{{ content.field_blog_image }}

					{% if label %}
						<h2 class="design1__title">
							{{ node.label }}
						</h2>
					{% endif %}
				</div>
			{% endif %}

			<span class="design1__image__content__overlay"></span>
		</div>

		{% if content.field_author %}
			<div class="design1__author">
				{{ content.field_author }}
			</div>
		{% endif %}
	</div>

</div>
